rules_version = '2';

// Due Crew — Firestore rules (v2.2: cheer notes; v2.0: one hosted backend).
//
// Model: friendship is consent-based. Your own `friends` array controls who
// may read your daily stats. The client only ever writes documents it owns.
// The Everyone board is opt-in and symmetric: `openBoard` on your profile
// both publishes your row and lets you read others'.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFriend(userId) {
      return isAuthenticated() &&
             request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.friends;
    }

    function isSharing(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.openBoard == true;
    }

    match /users/{userId} {
      // Profiles are readable by any signed-in user. The client uses this to
      // show display names and to detect "did they add me back?".
      allow read: if isAuthenticated();

      allow create, update, delete: if isOwner(userId);

      match /daily_stats/{statsId} {
        // Stats are readable only by the owner and people the owner added.
        allow read: if isOwner(userId) || isFriend(userId);
        allow write: if isOwner(userId);
      }

      // v1.2: shared-deck progress and (v1.3) the heatmap. Same consent gate.
      match /shared/{doc} {
        allow read: if isOwner(userId) || isFriend(userId);
        allow write: if isOwner(userId);
      }

      // v1.2: cheers. Only people the owner added may send, one doc per
      // sender (the doc id), only the three emoji and — since v2.2 — an
      // optional note of at most 80 characters. Nothing else in the doc.
      match /cheers/{senderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isFriend(userId)
                              && request.auth.uid == senderId
                              && request.resource.data.keys().hasOnly(['emoji', 'name', 'at', 'note'])
                              && request.resource.data.emoji in ['🎉', '💪', '🔥']
                              && (!('note' in request.resource.data)
                                  || (request.resource.data.note is string
                                      && request.resource.data.note.size() <= 80));
      }

      // v1.8: knocks — "wants to be crew", one small doc per sender, only
      // between people who are both on the Everyone board. Overwrite
      // semantics: one outstanding knock per sender.
      match /knocks/{senderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isAuthenticated()
                              && request.auth.uid == senderId
                              && isSharing(userId)
                              && isSharing(request.auth.uid)
                              && request.resource.data.keys().hasOnly(['name', 'at']);
      }
    }

    // v2.0: the Everyone board — one row per sharer per (local) day.
    // Rows are partitioned by day so the client can ask for the top N by
    // reviews with a single-field index and count its own rank with an
    // aggregation, instead of reading every row. Reading requires the reader
    // to be sharing too; writing requires the writer to be sharing.
    match /boards/{day}/rows/{userId} {
      allow read: if isAuthenticated() && isSharing(request.auth.uid);
      allow create, update: if isOwner(userId)
                            && isSharing(userId)
                            && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                            && request.resource.data.keys().hasOnly(
                                 ['name', 'reviews', 'studyTimeMs', 'streak', 'updatedAt'])
                            && request.resource.data.reviews is int
                            && request.resource.data.reviews >= 0;
      allow delete: if isOwner(userId);
    }

    // Retired in v2.0: v1.8–v1.9 wrote unscoped rows here. Closed to reads
    // and writes; owners may still delete their old row (the client does,
    // once). Delete the collection from the console after the rollout.
    match /server_board/{userId} {
      allow read, create, update: if false;
      allow delete: if isOwner(userId);
    }

    // Rules-generation markers — no data ever lives here. The client GETs
    // meta/<its marker> once a day: 404 means these rules are current for
    // it, 403 means the deployed rules predate it. The list is CUMULATIVE
    // (newer rules must still satisfy older clients' probes); add a version
    // here and bump RULES_MARKER in backend/firebase.py together.
    match /meta/{marker} {
      allow get: if marker in ['rules-v2', 'rules-v3', 'rules-v4', 'rules-v5'];
      allow list, create, update, delete: if false;
    }

    match /friend_codes/{code} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Only the code's current owner may repoint it, and only at themselves.
      // Without the first condition, anyone could hijack an existing code.
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // v2.0.1 grace period: the v1.4–v1.9 crew-server directory stays
    // READABLE so crews that registered on v1.x keep working (their v1.x
    // clients look up name+code here on every join) until they move to the
    // hosted backend. Nothing new can be registered: creation is closed here
    // and anonymous auth is off. Delete both collections from the console
    // once every such crew has moved.
    match /server_names/{name} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /servers/{key} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }
  }
}
