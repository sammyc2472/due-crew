rules_version = '2';

// Due Crew — Firestore rules (v2.13: my settings, readable only by me, so
// they follow me to my other computers; v2.10: a cheer may be a good-luck line or a
// tip on one card; v2.9: adding a code knocks its owner;
// v2.7: any one emoji in a cheer; v2.5: friend edges, crew emoji, squad week
// counts, block list and founder handoff; v2.4: hardening; v2.3: squads;
// v2.2: cheer notes; v2.0: one hosted backend).
//
// Model: friendship is consent-based. Your own `friends` array controls who
// may read your daily stats. The client only ever writes documents it owns.
// Squads are private boards with a door: the squad id is derived from its
// invite code, so holding the id is the invite — nothing is listed or
// searchable. A member's doc doubles as their row; reading a squad needs
// your own membership doc to exist, joining needs the door open.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // v2.5: a friendship is an edge doc users/{owner}/friends/{friend} that
    // only the two of them can see. The profile's `friends` array is still
    // honoured during the changeover (older clients write only that).
    function isFriend(userId) {
      return isAuthenticated()
             && (exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
                 || ('friends' in get(/databases/$(database)/documents/users/$(userId)).data
                     && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.friends));
    }

    function isSquadMember(squadId) {
      return exists(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid));
    }

    function squadDoc(squadId) {
      return get(/databases/$(database)/documents/squads/$(squadId)).data;
    }

    // Profiles: any signed-in user may GET one by uid (names, add-back
    // detection). Nobody may LIST them — a listing would hand out every
    // name, friend graph, and exam date on the service. Owners write freely
    // (older clients still send retired fields) within a few bounds.
    function profileShape(data) {
      return (!('displayName' in data)
              || (data.displayName is string && data.displayName.size() <= 60))
             && (!('friends' in data) || (data.friends is list && data.friends.size() <= 500))
             && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 16));
    }

    function squadShape(data) {
      return data.keys().hasOnly(['name', 'founder', 'open', 'createdAt', 'banned'])
             && data.name is string
             && data.name.size() >= 1
             && data.name.size() <= 24
             && data.open is bool
             && (!('banned' in data) || (data.banned is list && data.banned.size() <= 200));
    }

    function isBanned(squadId) {
      return 'banned' in squadDoc(squadId) && request.auth.uid in squadDoc(squadId).banned;
    }

    function memberShape(data) {
      return data.keys().hasOnly(['name', 'joinedAt', 'day', 'reviews', 'studyTimeMs',
                                  'accuracy', 'streak', 'updatedAt', 'week', 'emoji'])
             && data.name is string
             && data.name.size() <= 60
             && (!('week' in data) || (data.week is int && data.week >= 0 && data.week <= 7))
             && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 16))
             && (!('reviews' in data) || (data.reviews is int && data.reviews >= 0))
             && (!('studyTimeMs' in data) || (data.studyTimeMs is int && data.studyTimeMs >= 0))
             && (!('streak' in data) || (data.streak is int && data.streak >= 0))
             && (!('accuracy' in data)
                 || (data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100))
             && (!('day' in data) || data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create, update: if isOwner(userId) && profileShape(request.resource.data);
      allow delete: if isOwner(userId);

      // v2.5: one doc per person I've added. Readable by me and by that
      // person (so they can tell I added them back); never listable by
      // anyone else, so nobody can read off a friend graph.
      match /friends/{friendId} {
        allow get: if isOwner(userId) || (isAuthenticated() && request.auth.uid == friendId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && request.resource.data.keys().hasOnly(['at']);
        allow delete: if isOwner(userId);
      }

      match /daily_stats/{statsId} {
        // Stats are readable only by the owner and people the owner added.
        allow read: if isOwner(userId) || isFriend(userId);
        allow write: if isOwner(userId);
      }

      // v2.13: my settings (privacy switches, dates, squads, shared decks),
      // for my other computers. Only I can read or write them; one doc.
      match /private/{doc} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && doc == 'settings'
                              && request.resource.data.keys().hasOnly(['v', 'at', 'settings'])
                              && request.resource.data.settings is map;
      }

      // v1.2: shared-deck progress and (v1.3) the heatmap. Same consent gate.
      match /shared/{doc} {
        allow read: if isOwner(userId) || isFriend(userId);
        allow write: if isOwner(userId);
      }

      // v1.2: cheers. Only people the owner added may send, one doc per
      // sender (the doc id), one emoji (any, since v2.7) and, since v2.2,
      // an optional note of at most 80 characters. v2.10: `luck` marks a
      // line held for the owner's exam morning; `guid` names the one card a
      // tip is about.
      match /cheers/{senderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isFriend(userId)
                              && request.auth.uid == senderId
                              && request.resource.data.keys().hasOnly(['emoji', 'name', 'at', 'note', 'luck', 'guid'])
                              // v2.7: any one emoji. Rules can't see graphemes; the shape
                              // is "no letters, digits or spaces, at most 16 UTF-16 units"
                              // (the unit size() counts — measured), and the client keeps
                              // exactly one cluster on send and on receive.
                              && request.resource.data.emoji is string
                              && request.resource.data.emoji.size() <= 16
                              && request.resource.data.emoji.matches('^[^A-Za-z0-9 ]+$')
                              && request.resource.data.name is string
                              && request.resource.data.name.size() <= 60
                              && request.resource.data.at is timestamp
                              && (!('note' in request.resource.data)
                                  || (request.resource.data.note is string
                                      && request.resource.data.note.size() <= 80))
                              && (!('luck' in request.resource.data)
                                  || request.resource.data.luck is bool)
                              && (!('guid' in request.resource.data)
                                  || (request.resource.data.guid is string
                                      && request.resource.data.guid.size() <= 40));
      }

      // v2.3: knocks — "added you", one small doc per sender, overwrite
      // semantics: one outstanding knock per sender. Allowed between two
      // members of the same squad, or (v2.9) from someone holding the
      // recipient's own friend code, which only the recipient hands out:
      // adding a code tells its owner, who adds back in one click.
      match /knocks/{senderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isAuthenticated()
                              && request.auth.uid == senderId
                              && request.resource.data.keys().hasOnly(['name', 'at', 'squad', 'code'])
                              && request.resource.data.name is string
                              && request.resource.data.name.size() <= 60
                              && request.resource.data.at is timestamp
                              && (('squad' in request.resource.data
                                   && request.resource.data.squad is string
                                   && request.resource.data.squad.size() <= 40
                                   && isSquadMember(request.resource.data.squad)
                                   && exists(/databases/$(database)/documents/squads/$(request.resource.data.squad)/members/$(userId)))
                                  || ('code' in request.resource.data
                                      && request.resource.data.code is string
                                      && request.resource.data.code.size() == 6
                                      && get(/databases/$(database)/documents/friend_codes/$(request.resource.data.code)).data.userId == userId));
      }
    }

    // v2.3: squads. The id is sha1 of the invite code — unguessable, never
    // listed. Anyone signed in may GET a squad they hold the id of (the join
    // preview); only the founder may change it (name, lock) or delete it.
    match /squads/{squadId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
                    && request.resource.data.founder == request.auth.uid
                    && squadShape(request.resource.data);
      // the founder may hand the squad to a current member (v2.5)
      allow update: if isAuthenticated()
                    && resource.data.founder == request.auth.uid
                    && (request.resource.data.founder == resource.data.founder
                        || exists(/databases/$(database)/documents/squads/$(squadId)/members/$(request.resource.data.founder)))
                    && squadShape(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.founder == request.auth.uid;

      // A member's doc is their row: name plus today's numbers. Members read
      // the whole collection (one query, one read per member); you write only
      // your own; joining needs the door open; the founder may remove anyone.
      //
      // A join must carry joinedAt. Clients write their daily row with a
      // PATCH, and a PATCH to a missing doc is an INSERT — so without this,
      // someone the founder removed was re-created by their own next sync
      // and "Remove" undid itself on any open squad (2.3.0–2.5.0). A real
      // join always sends joinedAt; a row update never does.
      match /members/{userId} {
        allow read: if isAuthenticated() && isSquadMember(squadId);
        allow create: if isOwner(userId)
                      && squadDoc(squadId).open == true
                      && !isBanned(squadId)
                      && 'joinedAt' in request.resource.data
                      && request.resource.data.joinedAt is timestamp
                      && memberShape(request.resource.data);
        allow update: if isOwner(userId)
                      && memberShape(request.resource.data);
        allow delete: if isOwner(userId)
                      || (isAuthenticated() && squadDoc(squadId).founder == request.auth.uid);
      }
    }

    // Rules-generation markers — no data ever lives here. The client GETs
    // meta/<its marker> once a day: 404 means these rules are current for
    // it, 403 means the deployed rules predate it. The list is CUMULATIVE
    // (newer rules must still satisfy older clients' probes); add a version
    // here and bump RULES_MARKER in backend/firebase.py together.
    match /meta/{marker} {
      allow get: if marker in ['rules-v2', 'rules-v3', 'rules-v4', 'rules-v5', 'rules-v6', 'rules-v7', 'rules-v8', 'rules-v9', 'rules-v10', 'rules-v11'];
      allow list, create, update, delete: if false;
    }

    match /friend_codes/{code} {
      // get only: a listing would enumerate every account
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Only the code's current owner may repoint it, and only at themselves.
      // Without the first condition, anyone could hijack an existing code.
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }
  }
}
