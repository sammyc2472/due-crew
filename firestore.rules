rules_version = '2';

// Due Crew — Firestore rules (v2.3: squads; v2.2: cheer notes; v2.0: one
// hosted backend).
//
// Model: friendship is consent-based. Your own `friends` array controls who
// may read your daily stats. The client only ever writes documents it owns.
// Squads are private boards with a door: the squad id is derived from its
// invite code, so holding the id is the invite — nothing is listed or
// searchable. A member's doc doubles as their row; reading a squad needs
// your own membership doc to exist, joining needs the door open.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFriend(userId) {
      return isAuthenticated() &&
             request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.friends;
    }

    function isSquadMember(squadId) {
      return exists(/databases/$(database)/documents/squads/$(squadId)/members/$(request.auth.uid));
    }

    function squadDoc(squadId) {
      return get(/databases/$(database)/documents/squads/$(squadId)).data;
    }

    function squadShape(data) {
      return data.keys().hasOnly(['name', 'founder', 'open', 'createdAt'])
             && data.name is string
             && data.name.size() >= 1
             && data.name.size() <= 24
             && data.open is bool;
    }

    function memberShape(data) {
      return data.keys().hasOnly(['name', 'joinedAt', 'day', 'reviews', 'studyTimeMs',
                                  'accuracy', 'streak', 'updatedAt'])
             && data.name is string
             && (!('reviews' in data) || (data.reviews is int && data.reviews >= 0))
             && (!('day' in data) || data.day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    match /users/{userId} {
      // Profiles are readable by any signed-in user. The client uses this to
      // show display names and to detect "did they add me back?".
      allow read: if isAuthenticated();

      allow create, update, delete: if isOwner(userId);

      match /daily_stats/{statsId} {
        // Stats are readable only by the owner and people the owner added.
        allow read: if isOwner(userId) || isFriend(userId);
        allow write: if isOwner(userId);
      }

      // v1.2: shared-deck progress and (v1.3) the heatmap. Same consent gate.
      match /shared/{doc} {
        allow read: if isOwner(userId) || isFriend(userId);
        allow write: if isOwner(userId);
      }

      // v1.2: cheers. Only people the owner added may send, one doc per
      // sender (the doc id), only the three emoji and, since v2.2, an
      // optional note of at most 80 characters.
      match /cheers/{senderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isFriend(userId)
                              && request.auth.uid == senderId
                              && request.resource.data.keys().hasOnly(['emoji', 'name', 'at', 'note'])
                              && request.resource.data.emoji in ['🎉', '💪', '🔥']
                              && (!('note' in request.resource.data)
                                  || (request.resource.data.note is string
                                      && request.resource.data.note.size() <= 80));
      }

      // v2.3: knocks — "wants to be crew", one small doc per sender, only
      // between two members of the same squad. Overwrite semantics: one
      // outstanding knock per sender.
      match /knocks/{senderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isAuthenticated()
                              && request.auth.uid == senderId
                              && request.resource.data.keys().hasOnly(['name', 'at', 'squad'])
                              && request.resource.data.squad is string
                              && isSquadMember(request.resource.data.squad)
                              && exists(/databases/$(database)/documents/squads/$(request.resource.data.squad)/members/$(userId));
      }
    }

    // v2.3: squads. The id is sha1 of the invite code — unguessable, never
    // listed. Anyone signed in may GET a squad they hold the id of (the join
    // preview); only the founder may change it (name, lock) or delete it.
    match /squads/{squadId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
                    && request.resource.data.founder == request.auth.uid
                    && squadShape(request.resource.data);
      allow update: if isAuthenticated()
                    && resource.data.founder == request.auth.uid
                    && request.resource.data.founder == resource.data.founder
                    && squadShape(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.founder == request.auth.uid;

      // A member's doc is their row: name plus today's numbers. Members read
      // the whole collection (one query, one read per member); you write only
      // your own; joining needs the door open; the founder may remove anyone.
      match /members/{userId} {
        allow read: if isAuthenticated() && isSquadMember(squadId);
        allow create: if isOwner(userId)
                      && squadDoc(squadId).open == true
                      && memberShape(request.resource.data);
        allow update: if isOwner(userId)
                      && memberShape(request.resource.data);
        allow delete: if isOwner(userId)
                      || (isAuthenticated() && squadDoc(squadId).founder == request.auth.uid);
      }
    }

    // Rules-generation markers — no data ever lives here. The client GETs
    // meta/<its marker> once a day: 404 means these rules are current for
    // it, 403 means the deployed rules predate it. The list is CUMULATIVE
    // (newer rules must still satisfy older clients' probes); add a version
    // here and bump RULES_MARKER in backend/firebase.py together.
    match /meta/{marker} {
      allow get: if marker in ['rules-v2', 'rules-v3', 'rules-v4', 'rules-v5', 'rules-v6'];
      allow list, create, update, delete: if false;
    }

    match /friend_codes/{code} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

      // Only the code's current owner may repoint it, and only at themselves.
      // Without the first condition, anyone could hijack an existing code.
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;

      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }
  }
}
